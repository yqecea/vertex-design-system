{
  "name": "vertex-industrial",
  "version": "1.0.0",
  "description": "Vertex Industrial Design System — Real Geist + Industrial Frontend + Frosted Glass",
  "main": "dist/vertex-industrial.css",
  "scripts": {
    "build": "node build.js",
    "build:minify": "node build.js --minify",
    "watch": "node -e \"const fs=require('fs'),{exec}=require('child_process');console.log('Watching...');fs.watch('.',{recursive:true},(e,f)=>{if(f&&f.endsWith('.css')){console.log('Change:',f);exec('node build.js')}})\""
  },
  "files": [
    "dist/",
    "src/",
    "docs/",
    "examples/",
    "assets/",
    "build.js",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "design-system",
    "css",
    "geist",
    "vercel",
    "industrial",
    "glass",
    "frosted-glass",
    "liquid-glass",
    "dark-mode",
    "ui",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yqecea/vertex-design-system.git"
  },
  "bugs": {
